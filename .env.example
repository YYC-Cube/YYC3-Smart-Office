# ============================================================
# YYC³ Configuration（YanYuCloudCube™ · 注册商标）
# 言启象限 | 语枢未来
# ============================================================
# 复制为 .env 后替换为真实值；占位符不是可用默认值。
# 禁止将真实密钥、口令、Tailscale 地址提交到仓库。

NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000
NEXT_STATIC_EXPORT=0

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_CHARACTERS
CSRF_SECRET=REPLACE_WITH_RANDOM_SECRET
IP_HASH_SALT=REPLACE_WITH_RANDOM_SALT

# 多实例部署时必填；单实例可留空，代码将降级为内存 CSRF 存储
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
